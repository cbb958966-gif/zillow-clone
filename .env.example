# =============================================================================
# HomeVista (Zillow Clone) - Environment Variables
# Copy this file to .env.local and fill in your own values.
# =============================================================================

# -----------------------------------------------------------------------------
# Next.js / Auth
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here
JWT_SECRET=your-jwt-secret-here

# -----------------------------------------------------------------------------
# Database (Prisma / MySQL)
# -----------------------------------------------------------------------------
DATABASE_URL="mysql://user:password@localhost:3306/homevista"

# -----------------------------------------------------------------------------
# Maps (Leaflet / CARTO basemaps + Mapbox geocoding)
# -----------------------------------------------------------------------------
# CARTO basemap API key (optional - tiles work without it but may be rate-limited)
# Get one at https://carto.com/
NEXT_PUBLIC_CARTO_API_KEY=your-carto-api-key-here

# Mapbox access token for address geocoding on the sell/list-your-home page
# Get one at https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-access-token-here

# -----------------------------------------------------------------------------
# Email (Nodemailer - Gmail SMTP for contact inquiries)
# -----------------------------------------------------------------------------
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-gmail-app-password
CONTACT_EMAIL=your-gmail-address@gmail.com

# -----------------------------------------------------------------------------
# Cloudinary (image uploads)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# -----------------------------------------------------------------------------
# Spline (3D tours)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SPLINE_SCENE_URL=your-spline-scene-url

# -----------------------------------------------------------------------------
# Google OAuth (NextAuth)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
